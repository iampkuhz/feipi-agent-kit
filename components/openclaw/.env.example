# 把需要的变量加入全局 ~/.env；不要在仓库创建真实 .env。
# ~/.openclaw/.env 会直接软链接到 ~/.env。

# 必填
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_CODE_MODEL_OPENAI=replace-with-model-id
LITELLM_API_KEY_OPENAI=replace-with-secret
OPENCLAW_GATEWAY_TOKEN=replace-with-secret
OPENCLAW_TG_BOT_TOKEN=replace-with-secret
CLASH_PROXY=http://127.0.0.1:7890

# 可选：Google 图片生成
GOOGLE_API_KEY=replace-with-secret

# 可选：managed skills
OPENCLAW_DINGTALK_WEBHOOK=replace-with-secret
OPENCLAW_DINGTALK_SECRET_KEY=replace-with-secret
OPENCLAW_OBSIDIAN_VAULT_DIR=/absolute/path/to/vault

# 原生 OpenAI 模型使用标准 HTTPS 代理，和 CLASH_PROXY 填相同地址。
HTTPS_PROXY=http://127.0.0.1:7890
NO_PROXY=127.0.0.1,localhost,::1,192.168.0.0/16
