# 新机批量补装的桌面清单，Homebrew 提权关闭。需管理员审核的包见 Brewfile.apps.admin。
# Chrome 为 Mermaid/PPT 提供浏览器，LibreOffice 为文档验证提供命令行转换。
cask "google-chrome"
cask "libreoffice"
# 当前工作终端、键盘、窗口与既有 Profile 字体。
cask "iterm2"
cask "rectangle"
cask "font-jetbrains-mono"
cask "font-jetbrains-mono-nerd-font"
# 冷安装中 LibreOffice 的系统字体回退会丢失中文；提供可嵌入的中文文档字体。
cask "font-noto-sans-cjk-sc"
# 仅安装 ChatGPT 桌面应用；Codex CLI 由锁定版本的命令行入口管理。
cask "chatgpt"
cask "visual-studio-code"
cask "intellij-idea"
cask "obsidian"
cask "notion"
cask "telegram"
cask "wechat"
# Homebrew 只准备搜狗输入法的原厂安装器，实际安装由本人在 macOS 界面完成。
cask "sogouinput"

# oMLX 命令行服务默认编译原生自定义内核，需要完整 Xcode 和 Metal Toolchain。
tap "jundot/omlx", "https://github.com/jundot/omlx", trusted: { formula: "omlx" }
brew "jundot/omlx/omlx", args: ["with-custom-kernel"], trusted: true

# 旧机已安装的研发应用；Qoder 编辑器与锁定安装的 qodercli 分开管理。
cask "datagrip"
cask "goland"
cask "pycharm"
cask "webstorm"
cask "rustrover"
cask "zed"
cask "qoder"
cask "comfy"
cask "podman-desktop"

# 旧机已有的浏览器、文档、绘图及媒体客户端。
cask "microsoft-edge"
cask "wpsoffice"
cask "xmind"
cask "omnigraffle"
cask "baidunetdisk"
cask "bilibili"
cask "qqmusic"
cask "videofusion"
cask "chatgpt-classic"

# 旧机已有的网络、同步、远程连接及桌面工具；安装不复制账号或授权。
cask "clash-verge-rev"
cask "itsycal"
cask "menumeters"
cask "openinterminal"

# 不重复安装 codex/claude-code/qodercli，统一使用 bootstrap/agents.sh。
# temurin@25 见管理员审核清单；FlClash/oMLX/Session Browser 使用 desktop-extras.sh。
# Chromium 只剩旧安装元数据且当前 cask 已停用，不作为可恢复的软件安装。
