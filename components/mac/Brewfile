# 个人 Mac 之间共享的 Homebrew 依赖。
#
# 约定：
# - 多台 Mac 都需要的工具放在这里并提交到 dotfiles。
# - 仅当前机器需要的软件写入根目录 Brewfile.local（默认不提交）。
# - 不要用 `brew bundle dump --force` 覆盖本文件，以免混入整台机器的软件快照。

# 基础开发环境
brew "git"
brew "gh"
# 链接入口依赖 Stow；终端编辑器配置依赖 Neovim。
brew "stow"
brew "neovim"
# nvim-treesitter main 分支编译 parser 需要 tree-sitter CLI，不能仅依赖运行库。
brew "tree-sitter-cli"
# Python 为脚本提供基础解释器；项目环境由 uv 管理，不全局恢复旧机 pip 包。
brew "python"
brew "uv"
# OpenClaw 部署、服务配置和诊断直接调用 jq；不能依赖其他软件偶然带入。
brew "jq"
# 当前终端、研发与数据库维护常用工具，统一在新机补齐。
brew "ripgrep"
brew "tree"
brew "tmux"
brew "git-filter-repo"
brew "libpq"
# Zsh 已加载 Python/Ruby 多版本管理器；不复制旧机的解释器或虚拟环境。
brew "pyenv"
brew "rbenv"
# Go 项目与命令行构建使用；Node 和 Rust 仍由各自 bootstrap 管理。
brew "go"

# 脚本与配置质量检查
brew "shellcheck"
brew "shfmt"
brew "yamlfmt"
brew "stylua"

# 编辑、文档与日常命令行工具
# Node 不在 Homebrew 重复安装；bootstrap/node.sh 先准备 Node，再补装 Yarn/Prettier。
brew "pdf2svg"
brew "imagemagick"
# 技能的 PDF 文本/页面处理和 Graphviz 渲染需要真实命令入口。
brew "poppler"
# LibreOffice 自带 Fontconfig 的默认路径未覆盖 Apple Silicon Homebrew；显式提供字体配置。
brew "fontconfig"
brew "graphviz"
brew "exiftool"
brew "grip"
brew "wget"

# 模型与视频处理能力
brew "hf"
brew "ffmpeg"
brew "yt-dlp"

# 本地服务运行时
brew "podman"
brew "podman-compose"

# 补齐旧机主动安装的工具；第三方 tap 使用全名，首次安装由 Bundle 准备对应 tap。
tap "sdkman/tap"
brew "anchor"
brew "caddy"
brew "cloudflared"
brew "cpanminus"
brew "fswatch"
brew "librsvg"
brew "mpv"
brew "netpbm"
brew "nmap"
brew "potrace"
# Homebrew Bundle 在加载配方前只为这一项记录信任，范围限定为 SDKMAN CLI。
brew "sdkman/tap/sdkman-cli", trusted: true
brew "smartmontools"
brew "svgo"
brew "tailscale"
brew "zsh"
# Codex CLI 统一由 Homebrew 管理，供终端与 Multica 共用。
cask "codex"
# Multica Cloud 使用官方 CLI；Bundle 仅信任该配方。
tap "multica-ai/tap"
brew "multica-ai/tap/multica", trusted: true
# 保留旧机主动安装的 Python 3.14；不替换上面的默认 Python。
brew "python@3.14"
# Node/Rust 已由 node.sh/rust.sh 管理；Prettier、prettierd、Yarn 由 node.sh 管理。
# Zsh 插件由 ohmyzsh.sh 管理（语法高亮使用 fast-syntax-highlighting），不重复安装 Brew 插件。
# 其余间接依赖由 Homebrew 解析当前依赖树，不固定旧机的底层库版本。
# 旧机 steipete/tap/bird 的配方现已移除，不用不同软件 birdclaw 冒充恢复。
# 完整新机的软件界面入口见 Brewfile.apps；本机附加选择仍放 Brewfile.local。
