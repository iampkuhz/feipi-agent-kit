# 个人 Mac 之间共享的 Homebrew 依赖。
#
# 约定：
# - 多台 Mac 都需要的工具放在这里并提交到 dotfiles。
# - 仅当前机器需要的软件写入根目录 Brewfile.local（默认不提交）。
# - 不要用 `brew bundle dump --force` 覆盖本文件，以免混入整台机器的软件快照。

# 基础开发环境
brew "git"
brew "gh"
# 链接入口依赖 Stow；终端编辑器配置依赖 Neovim。
brew "stow"
brew "neovim"
# nvim-treesitter main 分支编译 parser 需要 tree-sitter CLI，不能仅依赖运行库。
brew "tree-sitter-cli"
# Python 为脚本提供基础解释器；项目环境由 uv 管理，不全局恢复旧机 pip 包。
brew "python"
brew "uv"
# OpenClaw 部署、服务配置和诊断直接调用 jq；不能依赖其他软件偶然带入。
brew "jq"
# 当前终端、研发与数据库维护常用工具，统一在新机补齐。
brew "ripgrep"
brew "tree"
brew "tmux"
brew "git-filter-repo"
brew "libpq"
# Zsh 已加载 Python/Ruby 多版本管理器；不复制旧机的解释器或虚拟环境。
brew "pyenv"
brew "rbenv"
# Go 项目与命令行构建使用；Node 和 Rust 仍由各自 bootstrap 管理。
brew "go"

# 脚本与配置质量检查
brew "shellcheck"
brew "shfmt"
brew "yamlfmt"
brew "stylua"

# 编辑、文档与日常命令行工具
# Node 不在 Homebrew 重复安装；bootstrap/node.sh 先准备 Node，再补装 Yarn/Prettier。
brew "pdf2svg"
brew "imagemagick"
# 技能的 PDF 文本/页面处理和 Graphviz 渲染需要真实命令入口。
brew "poppler"
brew "graphviz"
brew "exiftool"
brew "grip"
brew "wget"

# 模型与视频处理能力
brew "hf"
brew "ffmpeg"
brew "yt-dlp"
brew "whisper-cpp"

# 本地服务运行时
brew "podman"
brew "podman-compose"
# 完整新机的软件界面入口见 Brewfile.apps；本机附加选择仍放 Brewfile.local。
