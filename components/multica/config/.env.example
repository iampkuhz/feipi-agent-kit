# 待部署模板，不含真实秘密。服务环境文件放在仓库外：
# ~/.config/multica-selfhost/server.env，目录 0700，文件 0600。
# 从现有秘密源投影三个必填值；不要原样启动，也不要提交实际文件。
POSTGRES_DB=multica
POSTGRES_USER=multica
POSTGRES_PASSWORD=
JWT_SECRET=
MULTICA_VCS_SECRET_KEY=

PORT=8080
FRONTEND_PORT=3000
FRONTEND_ORIGIN=http://localhost:3000
MULTICA_APP_URL=http://localhost:3000
MULTICA_PUBLIC_URL=http://localhost:8080
APP_ENV=production
MULTICA_IMAGE_TAG=v0.6.3
MULTICA_VCS_INTEGRATION_ENABLED=true
DO_NOT_TRACK=1

# 首次只在 loopback 登录；创建账户后按真实邮箱收紧，禁止填占位邮箱后启动。
ALLOW_SIGNUP=true
ALLOWED_EMAILS=
# 不设置固定验证码；初期由用户在本机日志中读取一次性验证码。
