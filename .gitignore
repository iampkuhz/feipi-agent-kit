.DS_Store

.idea/

tmp/
/downloads/
logs/
**/logs/**
/tools/night-runner/

# Python cache
__pycache__/
*.pyc

# Node dependencies (skill-local and repo-level)
node_modules/

# 本地服务密钥配置
tools/gateway/litellm/env/.env
# ChatGPT OAuth token 持久化（不得提交）
**/chatgpt-tokens/
**/auth.json
# LiteLLM 日志
tools/gateway/litellm/**/*.log
/tools/search/searxng/settings/settings.yml.new
/output/*

# 保持旧版 Crawl4AI 本机配置为私有文件。
/tools/crawl/crawl4ai/env/.env
/tools/crawl/crawl4ai/env/.env.local

# 根环境文件可能包含本机密钥，仅保留 .env.example 模板。
/.env

# 工作台私有资料只在 HOME；误放到这些常见位置也不进入公开 Git。
/private/
/backups/
/router.json
/components/openclash/private/
/components/openclash/backups/
/components/openclash/core/
/components/openclash/config/
/components/openclash/*.tar.gz
