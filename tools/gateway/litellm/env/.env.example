# LiteLLM 轻量代理 - 环境变量参考
# 注意：
# 1. 脚本不会读取仓库内或 LiteLLM 目录下的 .env 文件。
# 2. 真实配置请写入 ~/.env，并确保 zsh 启动时已 export 到当前 shell 环境。
# 3. docker-compose.yml 已内置本地默认值；这里仅列出通常需要用户关心的变量。

# ==============================================================================
# ChatGPT 订阅转发：默认已内置，通常只需要替换管理 token
# ==============================================================================

# LiteLLM 网关管理 token，用于 Dashboard、脚本诊断和管理接口。
# 不设置也可以本地启动；客户端不要直接使用 master key。
# 生成命令：openssl rand -hex 16
export LITELLM_MASTER_KEY=replace-with-a-long-random-token

# Codex 标准模型名在 config/config.yaml 中严格转发到同名 chatgpt/... 上游。
# 不需要配置 LITELLM_CODEX_MODEL 或 LITELLM_UPSTREAM_CODEX_MODEL。

# ==============================================================================
# 客户端 private key：来自 Dashboard -> Virtual Keys 手工创建
# ==============================================================================

# 这两项不参与容器启动；首次搭建时可先启动 Dashboard，创建 Virtual Keys 后再补齐。

# OpenAI / Codex / OpenAI-compatible 客户端使用。
export LITELLM_API_KEY_OPENAI=replace-with-key-for-openai-secret-key

# Anthropic / Claude-code / Anthropic-compatible 客户端使用。
export LITELLM_API_KEY_ANTHROPIC=replace-with-key-for-claude-code-secret-key

# ==============================================================================
# 可选：百炼上游配置
# ==============================================================================

# litellm-code-openai / litellm-code-anthropic 默认使用百炼兼容端点。
# 如果你已有 BAILIAN_CODING_PLAN_API_KEY 或 BAILIAN_API_KEY，脚本会自动复用。
# 只有需要覆盖时才配置下面这些变量。

# export LITELLM_UPSTREAM_CODE_MODEL_OPENAI_NAME=openai/qwen-plus
# export LITELLM_UPSTREAM_CODE_MODEL_OPENAI_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# export LITELLM_UPSTREAM_CODE_MODEL_OPENAI_KEY=<百炼 API Key>

# export LITELLM_UPSTREAM_CODE_MODEL_ANTHROPIC_NAME=anthropic/qwen-plus
# export LITELLM_UPSTREAM_CODE_MODEL_ANTHROPIC_BASE=https://dashscope.aliyuncs.com/compatible-mode/v1
# export LITELLM_UPSTREAM_CODE_MODEL_ANTHROPIC_KEY=<百炼 API Key>

# 本地补全默认走 host.containers.internal:11434/v1。
# export LITELLM_UPSTREAM_AUTOCOMPLETE_MODEL_OPENAI_NAME=openai/qwen-turbo
# export LITELLM_UPSTREAM_AUTOCOMPLETE_MODEL_OPENAI_BASE=http://host.containers.internal:11434/v1
# export LITELLM_UPSTREAM_AUTOCOMPLETE_MODEL_OPENAI_KEY=dummy-key

# ==============================================================================
# 可选：容器访问外网代理
# ==============================================================================

# 默认就是宿主机 7890 端口，通常不需要写入 ~/.env。
# 只有代理端口不同，或需要禁用代理时才配置。
# export LITELLM_CONTAINER_HTTP_PROXY=http://host.containers.internal:7890
# export LITELLM_CONTAINER_HTTPS_PROXY=http://host.containers.internal:7890

# ==============================================================================
# 可选：沿用旧数据库密码
# ==============================================================================

# docker-compose.yml 默认使用 litellm_password。
# 只有你之前已经用其他 PostgreSQL 密码初始化过数据目录时才需要配置。
# export POSTGRES_PASSWORD=litellm_password
