{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "mindmap-brief",
  "type": "object",
  "additionalProperties": false,
  "required": ["diagram_id", "diagram_type", "title", "nodes", "layout"],
  "properties": {
    "diagram_id": {"type": "string", "pattern": "^(D[1-9][0-9]*|[a-z][a-z0-9-]*)$"},
    "diagram_type": {"type": "string", "enum": ["mindmap"]},
    "title": {"type": "string", "minLength": 1, "maxLength": 48},
    "nodes": {
      "type": "array", "minItems": 2, "maxItems": 32,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["id", "parent", "label"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
          "parent": {"type": "string", "pattern": "^([a-z][a-z0-9_]*)?$"},
          "label": {"type": "string", "minLength": 1, "maxLength": 96}
        }
      }
    },
    "layout": {
      "type": "object", "additionalProperties": false,
      "required": ["direction"],
      "properties": {"direction": {"type": "string", "enum": ["balanced", "right", "left"]}}
    },
    "out_of_scope": {"type": "array", "items": {"type": "string", "minLength": 1, "maxLength": 80}}
  }
}
