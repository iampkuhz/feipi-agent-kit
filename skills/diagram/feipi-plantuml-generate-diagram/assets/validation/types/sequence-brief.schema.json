{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "sequence-brief",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "diagram_id",
    "diagram_type",
    "title",
    "summary",
    "participants",
    "messages"
  ],
  "properties": {
    "diagram_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 50,
      "pattern": "^(D[1-9][0-9]*|[a-z][a-z0-9-]*)$"
    },
    "diagram_type": {
      "type": "string",
      "enum": ["sequence"]
    },
    "numbering_scheme": {
      "type": "string",
      "enum": ["interaction_mr", "process_s"]
    },
    "title": {
      "type": "string",
      "minLength": 4,
      "maxLength": 80
    },
    "summary": {
      "type": "string",
      "minLength": 10,
      "maxLength": 200
    },
    "participants": {
      "type": "array",
      "minItems": 2,
      "maxItems": 8,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "type", "description"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "type": {
            "type": "string",
            "enum": ["actor", "participant", "database"]
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          }
        }
      }
    },
    "messages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "from", "to", "description", "type"],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^([MR][1-9][0-9]*|S[1-9][0-9]*(\\.[1-9][0-9]*)?)$"
          },
          "from": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "to": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "description": {
            "type": "string",
            "minLength": 2,
            "maxLength": 80
          },
          "type": {
            "type": "string",
            "enum": ["sync", "return", "async", "create", "destroy"]
          },
          "note": {
            "type": "string",
            "minLength": 1,
            "description": "可选消息说明，与当前消息一同输入；换行和方向由 note 排版器计算"
          }
        }
      }
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "required": ["direction", "include_legend"],
      "properties": {
        "direction": {
          "type": "string",
          "enum": ["left_to_right", "top_to_bottom"]
        },
        "include_legend": {
          "type": "boolean"
        },
        "note_geometry": {
          "type": "object",
          "additionalProperties": false,
          "required": ["left", "right", "x"],
          "description": "可选的 note 布局坐标，统一使用显示列；省略时按参与者顺序估算",
          "properties": {
            "left": {"type": "number"},
            "right": {"type": "number"},
            "x": {"type": "object", "additionalProperties": {"type": "number"}}
          }
        }
      }
    },
    "out_of_scope": {
      "type": "array",
      "maxItems": 10,
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 60
      }
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "participants"],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40,
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "name": {
            "type": "string",
            "minLength": 2,
            "maxLength": 40
          },
          "participants": {
            "type": "array",
            "minItems": 1,
            "maxItems": 8,
            "items": {
              "type": "string",
              "minLength": 2,
              "maxLength": 40
            }
          },
          "separator": {
            "type": "boolean",
            "description": "是否在该组相关消息段前添加 == 组名 == 分隔线；不得生成 PlantUML separator 关键字"
          }
        }
      }
    }
  }
}
