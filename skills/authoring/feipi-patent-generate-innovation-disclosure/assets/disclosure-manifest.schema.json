{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://feipi.local/schemas/disclosure-manifest.schema.json",
  "title": "专利创新交底包 Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "patent",
    "input_completeness",
    "boundaries",
    "sources",
    "keywords",
    "core_invention_claim",
    "innovations",
    "effects",
    "competitors",
    "diagrams",
    "reviews"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "patent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["title", "use_case"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "use_case": {"type": "string", "minLength": 1}
      }
    },
    "input_completeness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_objects", "core_mechanisms", "necessary_constraints", "existing_problem_facts"],
      "properties": {
        "technical_objects": {"$ref": "#/$defs/nonEmptyStringList"},
        "core_mechanisms": {"$ref": "#/$defs/nonEmptyStringList"},
        "necessary_constraints": {"$ref": "#/$defs/nonEmptyStringList"},
        "existing_problem_facts": {"$ref": "#/$defs/nonEmptyStringList"}
      }
    },
    "boundaries": {
      "type": "object",
      "additionalProperties": false,
      "required": ["business_domains", "system_ownership", "physical_boundaries", "deployment_triggers"],
      "properties": {
        "business_domains": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/businessDomain"}
        },
        "system_ownership": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/systemOwnership"}
        },
        "physical_boundaries": {
          "type": "array",
          "items": {"$ref": "#/$defs/physicalBoundary"}
        },
        "deployment_triggers": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "enum": ["cross_network", "cross_chain", "online_offline", "hsm", "manual_transfer", "manual_handoff"]
          }
        }
      }
    },
    "sources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["source_facts", "invention_extensions", "external_materials", "term_generalizations", "abbreviation_allowlist"],
      "properties": {
        "source_facts": {
          "type": "array",
          "minItems": 1,
          "items": {"$ref": "#/$defs/sourceFact"}
        },
        "invention_extensions": {
          "type": "array",
          "items": {"$ref": "#/$defs/inventionExtension"}
        },
        "external_materials": {
          "type": "array",
          "items": {"$ref": "#/$defs/externalMaterial"}
        },
        "term_generalizations": {
          "type": "array",
          "items": {"$ref": "#/$defs/termGeneralization"}
        },
        "abbreviation_allowlist": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      }
    },
    "keywords": {
      "type": "object",
      "additionalProperties": false,
      "required": ["technical_objects", "core_mechanisms", "key_constraints"],
      "properties": {
        "technical_objects": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/keyword"}},
        "core_mechanisms": {"type": "array", "minItems": 2, "maxItems": 4, "items": {"$ref": "#/$defs/keyword"}},
        "key_constraints": {"type": "array", "minItems": 1, "maxItems": 2, "items": {"$ref": "#/$defs/keyword"}}
      }
    },
    "core_invention_claim": {
      "type": "string",
      "minLength": 20
    },
    "innovations": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/innovation"}
    },
    "effects": {
      "type": "array",
      "minItems": 2,
      "maxItems": 4,
      "items": {"$ref": "#/$defs/effect"}
    },
    "competitors": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "evidence"],
      "properties": {
        "status": {"enum": ["ready", "pending_retrieval"]},
        "evidence": {
          "type": "array",
          "maxItems": 3,
          "items": {"$ref": "#/$defs/competitorEvidence"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"status": {"const": "ready"}}},
          "then": {"properties": {"evidence": {"minItems": 1}}}
        },
        {
          "if": {"properties": {"status": {"const": "pending_retrieval"}}},
          "then": {"properties": {"evidence": {"maxItems": 0}}}
        }
      ]
    },
    "diagrams": {
      "type": "array",
      "minItems": 2,
      "items": {"$ref": "#/$defs/diagram"}
    },
    "reviews": {
      "type": "object",
      "additionalProperties": false,
      "required": ["generalization_test", "causal_deletion_tests", "visual_reviews"],
      "properties": {
        "generalization_test": {"$ref": "#/$defs/review"},
        "causal_deletion_tests": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/causalReview"}
        },
        "visual_reviews": {
          "type": "array",
          "minItems": 2,
          "items": {"$ref": "#/$defs/visualReview"}
        }
      }
    }
  },
  "$defs": {
    "nonEmptyStringList": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {"type": "string", "minLength": 1}
    },
    "businessDomain": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "scope"],
      "properties": {
        "id": {"type": "string", "pattern": "^BD[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "scope": {"type": "string", "minLength": 1}
      }
    },
    "systemOwnership": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "owner", "boundary"],
      "properties": {
        "id": {"type": "string", "pattern": "^SYS[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "owner": {"type": "string", "minLength": 1},
        "boundary": {"type": "string", "minLength": 1}
      }
    },
    "physicalBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "type", "description"],
      "properties": {
        "id": {"type": "string", "pattern": "^PB[1-9][0-9]*$"},
        "type": {"type": "string", "minLength": 1},
        "description": {"type": "string", "minLength": 1}
      }
    },
    "sourceFact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "source_locator"],
      "properties": {
        "id": {"type": "string", "pattern": "^SF[1-9][0-9]*$"},
        "statement": {"type": "string", "minLength": 1},
        "source_locator": {"type": "string", "minLength": 1}
      }
    },
    "inventionExtension": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "statement", "basis_source_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^IE[1-9][0-9]*$"},
        "statement": {"type": "string", "minLength": 1},
        "basis_source_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^SF[1-9][0-9]*$"}
        }
      }
    },
    "externalMaterial": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "locator", "retrieved_at", "evidence_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^EM[1-9][0-9]*$"},
        "title": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date"},
        "evidence_type": {"enum": ["public_fact", "reasonable_inference"]}
      }
    },
    "termGeneralization": {
      "type": "object",
      "additionalProperties": false,
      "required": ["original", "generalized", "reason"],
      "properties": {
        "original": {"type": "string", "minLength": 1},
        "generalized": {"type": "string", "minLength": 1},
        "reason": {"type": "string", "minLength": 1}
      }
    },
    "keyword": {
      "type": "object",
      "additionalProperties": false,
      "required": ["term", "anchor"],
      "properties": {
        "term": {"type": "string", "minLength": 2},
        "anchor": {"type": "string", "minLength": 1}
      }
    },
    "innovation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "core_mechanism", "necessary_constraint", "substantive_difference", "anchors"],
      "properties": {
        "id": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
        "core_mechanism": {"type": "string", "minLength": 1},
        "necessary_constraint": {"type": "string", "minLength": 1},
        "substantive_difference": {"type": "string", "minLength": 1},
        "anchors": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(D|E|S)[1-9][0-9]*(\\.[1-9][0-9]*)?$"}
        }
      }
    },
    "effect": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "innovation_id", "original_problem", "mechanism", "observable_result", "verification_status", "evidence_source_ids"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
        "innovation_id": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
        "original_problem": {"type": "string", "minLength": 1},
        "mechanism": {"type": "string", "minLength": 1},
        "observable_result": {"type": "string", "minLength": 1},
        "verification_status": {"enum": ["verified", "expected_observable"]},
        "evidence_source_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {"type": "string", "pattern": "^(SF|EM)[1-9][0-9]*$"}
        }
      },
      "allOf": [
        {
          "if": {"properties": {"verification_status": {"const": "verified"}}},
          "then": {"properties": {"evidence_source_ids": {"minItems": 1}}}
        }
      ]
    },
    "competitorEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "product_or_business", "locator", "retrieved_at", "evidence_type"],
      "properties": {
        "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
        "name": {"type": "string", "minLength": 1},
        "product_or_business": {"type": "string", "minLength": 1},
        "locator": {"type": "string", "minLength": 1},
        "retrieved_at": {"type": "string", "format": "date"},
        "evidence_type": {"enum": ["public_fact", "reasonable_inference"]}
      }
    },
    "diagram": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "package_path", "purpose"],
      "properties": {
        "id": {"type": "string", "pattern": "^D[1-9][0-9]*$"},
        "role": {"enum": ["component_overview", "main_flow", "deployment_boundary", "module_detail", "core_mechanism"]},
        "package_path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
        },
        "purpose": {"type": "string", "minLength": 1}
      }
    },
    "review": {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "reviewer", "notes"],
      "properties": {
        "status": {"enum": ["pass", "fail", "pending"]},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "causalReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["innovation_id", "status", "reviewer", "notes"],
      "properties": {
        "innovation_id": {"type": "string", "pattern": "^I[1-9][0-9]*$"},
        "status": {"enum": ["pass", "fail", "pending"]},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    },
    "visualReview": {
      "type": "object",
      "additionalProperties": false,
      "required": ["diagram_id", "svg_sha256", "status", "reviewer", "notes"],
      "properties": {
        "diagram_id": {"type": "string", "pattern": "^D[1-9][0-9]*$"},
        "svg_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "status": {"enum": ["pass", "fail", "pending"]},
        "reviewer": {"type": "string", "minLength": 1},
        "notes": {"type": "string", "minLength": 1}
      }
    }
  }
}
