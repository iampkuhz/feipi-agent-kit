{
  "schema_version": "1.2",
  "max_active_subagents": 1,
  "max_total_subagents": 3,
  "allow_recursive_spawn": false,
  "context_policy": "distilled_task_packet_only",
  "permission_enforcement": "task_contract_not_os_sandbox",
  "handoff_contract": "references/stage-delivery-contract.md",
  "main_agent_reporting_profile": "main_to_user",
  "task_packet_required_fields": [
    "task_file",
    "input_reference",
    "allowed_writes",
    "forbidden_actions",
    "return_format",
    "timing_log",
    "key_event_contract",
    "checkpoint_task"
  ],
  "checkpoint": {
    "path": "disclosure-workspace/working/CHECKPOINT.md",
    "task_catalog": "references/checkpoint-task-catalog.json",
    "coordinator": "main_agent",
    "state_model": "current_state_not_event_log",
    "task_granularity": "stage_deliverable_or_single_subagent_assignment",
    "update_on": [
      "stage_start",
      "task_complete",
      "waiting_user",
      "blocked"
    ],
    "silent_on": [
      "micro_step",
      "tool_call",
      "file_read",
      "file_write",
      "cache_hit",
      "retry",
      "resume_check",
      "unchanged_wait"
    ],
    "completion_gate": {
      "result_file_required": true,
      "nonempty": true,
      "minimum_check_required": true,
      "bind_sha256": true,
      "minimum_checks": [
        "nonempty",
        "markdown",
        "json",
        "tsv"
      ]
    },
    "resume": {
      "read_before_stage_status": true,
      "skip_completed_only_when_result_valid": true,
      "first_invalid_or_incomplete_task": true,
      "read_only": true
    },
    "rollback": {
      "decision_owner": "main_agent",
      "reason_required": true,
      "automatic_dependency_analysis": false
    }
  },
  "event_reporting": {
    "critical_events": [
      "MILESTONE",
      "DECISION",
      "BLOCKED",
      "COMPLETE"
    ],
    "silent_events": [
      "STARTED",
      "RUNNING",
      "HEARTBEAT",
      "STATUS",
      "TOOL_CALL",
      "FILE_READ",
      "FILE_WRITE",
      "CACHE_HIT",
      "WAIT_TIMEOUT",
      "RETRYING",
      "UNCHANGED"
    ],
    "unknown_event_policy": "reject_not_forward",
    "profiles": {
      "main_to_user": {
        "audience": "user",
        "emit_on": [
          "MILESTONE",
          "DECISION",
          "BLOCKED",
          "COMPLETE"
        ]
      },
      "subagent_to_main": {
        "audience": "main_agent",
        "emit_on": [
          "MILESTONE",
          "DECISION",
          "BLOCKED",
          "COMPLETE"
        ]
      }
    },
    "envelope": {
      "format": "[<EVENT>] <scope>｜<outcome>｜<next_or_artifact>",
      "max_lines": 1,
      "max_chars": 240,
      "overflow_policy": "shorten_outcome"
    },
    "lifecycle": {
      "max_milestones_per_scope": 1,
      "final_events": [
        "BLOCKED",
        "COMPLETE"
      ],
      "final_response_is_event": true,
      "duplicate_final_notification": false
    },
    "classification": {
      "complete_over_milestone": true,
      "decision_when_receiver_choice_can_unblock": true,
      "blocked_when_no_receiver_choice_can_unblock": true
    },
    "deduplicate": {
      "enabled": true,
      "key_fields": [
        "profile",
        "event",
        "scope",
        "outcome"
      ]
    },
    "wait_policy": {
      "mode": "event_driven_join",
      "main_agent_work_while_subagent_runs": true,
      "dependency_barrier_wait": "long_event_wait_with_nonterminal_timeout_continuation",
      "busy_wait": false,
      "periodic_poll": false,
      "heartbeat": false,
      "status_probe_between_waits": false,
      "short_wait_loop": false,
      "nonterminal_timeout_policy": "continue_long_event_wait_without_status_probe"
    }
  },
  "telemetry": {
    "coordinator": "main_agent",
    "log_path": "disclosure-workspace/working/session-timing.jsonl",
    "record_spawn": true,
    "record_execution": true,
    "record_wait": true
  },
  "fallback": {
    "when_subagents_unavailable": "main_agent_executes_same_lane",
    "when_model_unavailable": "omit_model_override_keep_reasoning_effort",
    "forbid_silent_upgrade_to_highest": true
  },
  "roles": [
    {
      "name": "patent_prior_art_researcher",
      "stage": "phase_1_material_modeling",
      "model": "gpt-5.6-luna",
      "reasoning_effort": "medium",
      "fork_turns": "none",
      "permission": "read_only",
      "reporting_profile": "subagent_to_main",
      "writes": [],
      "task_file": "disclosure-workspace/working/stages/agents/prior-art-task.md",
      "checkpoint_task": {
        "task_id": "phase-1-prior-art-research",
        "owner": "patent_prior_art_researcher",
        "result_path": "disclosure-workspace/working/stages/phase-1/research.tsv",
        "minimum_check": "tsv"
      },
      "input_contract": [
        "disclosure-workspace/working/stages/agents/prior-art-task.md",
        "basis_terms_and_context_terms",
        "source_ids_and_query_limits"
      ],
      "judgment_contract": [
        "source_relevance",
        "evidence_property",
        "research_stop_condition"
      ],
      "output_contract": {
        "format": "research.tsv rows",
        "cache_path": "disclosure-workspace/working/stages/phase-1/research.tsv",
        "message": "final_event_and_row_count_only",
        "writer": "main_agent"
      },
      "task": "使用一个 worker 并行执行两条限定检索线，返回来源、日期、证据属性和精简结论，不展开无关行业研究。"
    },
    {
      "name": "patent_diagram_engineer",
      "stage": "phase_3_final_drafting",
      "model": "gpt-5.6-terra",
      "reasoning_effort": "medium",
      "fork_turns": "none",
      "permission": "workspace_write",
      "reporting_profile": "subagent_to_main",
      "writes": [
        "disclosure-workspace/diagrams/"
      ],
      "task_file": "disclosure-workspace/working/stages/agents/diagram-task.md",
      "checkpoint_task": {
        "task_id": "phase-3-diagram-packages",
        "owner": "patent_diagram_engineer",
        "result_path": "disclosure-workspace/working/stages/phase-3/diagram-result.tsv",
        "minimum_check": "tsv"
      },
      "input_contract": [
        "disclosure-workspace/working/stages/phase-2/handoff.md",
        "diagram_responsibilities",
        "allowed_diagram_paths"
      ],
      "judgment_contract": [
        "diagram_type_and_trigger",
        "layout_and_numbering",
        "implemented_path_only"
      ],
      "output_contract": {
        "format": "diagram-result.tsv rows",
        "cache_path": "disclosure-workspace/working/stages/phase-3/diagram-result.tsv",
        "message": "final_event_and_paths_only",
        "writer": "main_agent"
      },
      "task": "根据已确认且冻结的 I/T/D/E/S 合同生成全部必要图包；每图只验证一次，只修改分配的 diagrams 目录。"
    },
    {
      "name": "patent_final_reviewer",
      "stage": "phase_4_review_delivery",
      "model": "gpt-5.6-sol",
      "reasoning_effort": "high",
      "fork_turns": "none",
      "permission": "read_only",
      "reporting_profile": "subagent_to_main",
      "writes": [],
      "task_file": "disclosure-workspace/working/stages/agents/final-review-task.md",
      "checkpoint_task": {
        "task_id": "phase-4-final-review",
        "owner": "patent_final_reviewer",
        "result_path": "disclosure-workspace/working/stages/phase-4/review.tsv",
        "minimum_check": "tsv"
      },
      "input_contract": [
        "disclosure-workspace/working/stages/phase-3/handoff.md",
        "disclosure-workspace/working/stages/phase-3/build-map.tsv",
        "relevant_quality_gates"
      ],
      "judgment_contract": [
        "implementation_extension_boundary",
        "causal_and_generalization_tests",
        "external_leak_and_svg_quality"
      ],
      "output_contract": {
        "format": "review.tsv rows",
        "cache_path": "disclosure-workspace/working/stages/phase-4/review.tsv",
        "message": "final_event_and_row_count_only",
        "writer": "main_agent"
      },
      "task": "一次性完成实现与扩展边界、因果删除、对外泄漏和最终 SVG 视觉复核，只返回结构化结论。"
    }
  ]
}
