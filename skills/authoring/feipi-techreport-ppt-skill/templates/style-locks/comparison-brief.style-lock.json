{
  "$schema": "../../schemas/style-lock.schema.json",
  "name": "comparison-brief",
  "version": "2.0.0",
  "description": "对比简报风格：聚焦差异、高亮关键决策点、避免全量矩阵",
  "design_profile": "cto-technical-report",
  "token_refs": [
    "typography.core",
    "colors.core",
    "spacing.core",
    "shape.core"
  ],
  "layout_refs": [
    "solution-comparison"
  ],
  "prohibited": [
    "full_page_gradient",
    "excessive_decoration",
    "rainbow_heatmap",
    "multiple_primary_colors",
    "mixed_font_families",
    "full_page_image_only",
    "no_conclusion_zone",
    "overlapping_elements",
    "font_size_below_minimum",
    "full_comparison_matrix_without_focus",
    "more_than_one_highlight_column"
  ],
  "density_limits": {
    "max_main_visuals": 1,
    "max_bullets": 5,
    "max_kpi_cards": 4,
    "max_comparison_objects": 4,
    "max_comparison_dimensions": 5,
    "max_table_rows": 5,
    "max_table_cols": 4,
    "highlight_columns": 1
  }
}
