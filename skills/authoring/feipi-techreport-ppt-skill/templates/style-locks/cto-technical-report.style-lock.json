{
  "$schema": "../../schemas/style-lock.schema.json",
  "name": "cto-technical-report",
  "version": "2.0.0",
  "description": "CTO 技术汇报默认风格：克制、清晰、结构化、高信息密度",
  "design_profile": "cto-technical-report",
  "token_refs": [
    "typography.core",
    "colors.core",
    "spacing.core",
    "shape.core"
  ],
  "layout_refs": [
    "layered-architecture",
    "solution-comparison",
    "multi-party-flow"
  ],
  "prohibited": [
    "full_page_gradient",
    "excessive_decoration",
    "rainbow_heatmap",
    "multiple_primary_colors",
    "mixed_font_families",
    "full_page_image_only",
    "no_conclusion_zone",
    "overlapping_elements",
    "font_size_below_minimum"
  ],
  "density_limits": {
    "max_main_visuals": 1,
    "max_bullets": 5,
    "max_kpi_cards": 5,
    "max_flow_steps": 7,
    "max_architecture_nodes": 9,
    "max_table_rows": 5,
    "max_table_cols": 4,
    "max_comparison_objects": 4,
    "max_comparison_dimensions": 5
  }
}
