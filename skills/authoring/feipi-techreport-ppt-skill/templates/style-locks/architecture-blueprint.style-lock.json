{
  "$schema": "../../schemas/style-lock.schema.json",
  "name": "architecture-blueprint",
  "version": "2.0.0",
  "description": "架构蓝图风格：强调分层、模块边界、数据流方向",
  "design_profile": "cto-technical-report",
  "token_refs": [
    "typography.core",
    "colors.core",
    "spacing.core",
    "shape.core"
  ],
  "layout_refs": [
    "layered-architecture"
  ],
  "prohibited": [
    "full_page_gradient",
    "excessive_decoration",
    "rainbow_heatmap",
    "multiple_primary_colors",
    "mixed_font_families",
    "full_page_image_only",
    "no_conclusion_zone",
    "overlapping_elements",
    "font_size_below_minimum",
    "unclear_layer_boundaries",
    "ambiguous_data_flow_direction"
  ],
  "density_limits": {
    "max_main_visuals": 1,
    "max_bullets": 5,
    "max_kpi_cards": 4,
    "max_flow_steps": 7,
    "max_architecture_nodes": 9,
    "max_layers": 5,
    "max_table_rows": 5,
    "max_table_cols": 4
  }
}
