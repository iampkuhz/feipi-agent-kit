{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Derived Style Lock Profile",
  "type": "object",
  "required": ["name", "version", "design_profile", "token_refs", "layout_refs", "prohibited", "density_limits"],
  "properties": {
    "$schema": { "type": "string" },
    "name": { "type": "string", "minLength": 1 },
    "version": { "type": "string" },
    "description": { "type": "string" },
    "design_profile": { "type": "string", "minLength": 1 },
    "token_refs": { "type": "array", "minItems": 4, "uniqueItems": true, "items": { "enum": ["typography.core", "colors.core", "spacing.core", "shape.core"] } },
    "layout_refs": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "type": "string" } },
    "prohibited": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "density_limits": { "type": "object", "additionalProperties": { "type": "integer", "minimum": 1 } }
  },
  "additionalProperties": false
}
