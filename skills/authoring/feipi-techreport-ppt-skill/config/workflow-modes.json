{
  "id": "workflow-modes",
  "description": "fast、review、strict 三种交互与 QA 模式；旧名称仅为 alias。",
  "aliases": { "draft": "fast", "production": "strict" },
  "modes": {
    "fast": {
      "requires_page_contract_confirmation": false,
      "requires_source_provenance": true,
      "qa_strategy": { "allow_warnings": true, "render_required": false, "visual_approval_required": false },
      "decision_policy": "仅在业务含义变化、删除重要内容或 split_required 时询问"
    },
    "review": {
      "requires_page_contract_confirmation": "only_material_decisions",
      "requires_source_provenance": true,
      "qa_strategy": { "allow_warnings": true, "render_required": true, "visual_approval_required": false },
      "decision_policy": "仅展示影响内容、布局或业务含义的少量决策"
    },
    "strict": {
      "requires_page_contract_confirmation": "only_material_decisions",
      "requires_source_provenance": true,
      "qa_strategy": { "allow_warnings": false, "render_required": true, "visual_approval_required": true },
      "decision_policy": "完整合同、package/editability QA、权威渲染与视觉签字"
    }
  }
}
