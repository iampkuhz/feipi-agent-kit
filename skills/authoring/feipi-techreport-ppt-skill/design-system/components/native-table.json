{
  "id": "component.native-table",
  "version": "1.0.0",
  "description": "PPTX 原生表格模块。用于短矩阵和关键数据，不承载全量数据表。",
  "depends_on": [
    "colors.core",
    "typography.core",
    "spacing.core"
  ],
  "base": {
    "header_fill": "surface.panel",
    "header_text": "text.primary",
    "body_text": "text.primary",
    "border": "border.default",
    "row_alt_fill": "surface.page",
    "highlight_fill": "surface.panel_blue",
    "font_family": "default",
    "header_font_size": "table_header",
    "body_font_size": "table_cell",
    "cell_padding": "table_cell",
    "align": "center",
    "vertical_align": "mid"
  },
  "variants": {
    "comparison_matrix": {
      "max_rows": 5,
      "max_cols": 4,
      "highlight_first_col": true,
      "highlight_target_col": true
    },
    "metric_table": {
      "max_rows": 6,
      "max_cols": 4,
      "right_align_numeric": true
    },
    "appendix_dense": {
      "max_rows": 10,
      "max_cols": 6,
      "requires_user_confirmation": true
    }
  },
  "rules": {
    "default_max_rows": 5,
    "default_max_cols": 4,
    "cell_max_chars": 60,
    "split_if_exceeds_budget": true,
    "avoid_full_page_table": true
  },
  "contract": {
    "slots": {
      "headers": { "type": "string_array", "text_role": "table_header", "max_lines": 2 },
      "rows": { "type": "table_rows", "text_role": "table_cell", "max_lines_per_cell": 2 }
    },
    "variants": ["comparison_matrix", "metric_table", "appendix_dense", "standard", "tech", "matrix"],
    "sizes": {
      "sm": { "max_rows": 4, "max_cols": 4, "cell_padding_token": "table_cell" },
      "md": { "max_rows": 6, "max_cols": 5, "cell_padding_token": "table_cell" },
      "lg": { "max_rows": 8, "max_cols": 6, "cell_padding_token": "table_cell" }
    },
    "allowed_regions": ["main", "main-right", "evidence"],
    "overflow_policy": ["compress_text", "change_component_size", "change_layout", "drop_secondary", "split_required"],
    "editable": { "native_table": true, "native_text": true, "object_name_required": true },
    "ai_may_change": ["variant", "size", "region_id", "content"],
    "ai_must_not_change": ["font", "font_size", "color", "padding", "coordinates"]
  }
}
