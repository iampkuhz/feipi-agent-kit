{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Feipi Skill Registry",
  "type": "object",
  "required": [
    "skills"
  ],
  "additionalProperties": false,
  "properties": {
    "skills": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^skills/[a-z0-9]+(?:-[a-z0-9]+)*(?:/[a-z0-9]+(?:-[a-z0-9]+)*)?/feipi-[a-z0-9]+(?:-[a-z0-9]+)*$"
      }
    }
  }
}
